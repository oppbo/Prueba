# ---------------------------------------------------------------------------
# CobraYa environment variables. Copy to .env.local (never commit .env.local).
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API → Project API keys → "anon" / "publishable" key.
# Safe for the browser: every query is still restricted by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API → "service_role" / secret key. SERVER ONLY.
# Used for: the public payment page (/p/[token]), proof uploads, the "Probar demo"
# sandbox and the seed/cleanup scripts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL used in payment links and auth emails.
# Local: http://localhost:3000 · Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: fixed demo login created by `npm run seed` (fictional data).
DEMO_USER_EMAIL=demo@cobraya.app
DEMO_USER_PASSWORD=change-me-to-a-long-random-password

# Optional: hours before "Probar demo" sandboxes are removed by `npm run demo:cleanup`.
DEMO_TTL_HOURS=24
